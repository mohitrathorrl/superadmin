# ========================================
# 🔐 Environment Configuration - RupeeLending
# ========================================

# ========================================
# 📊 DATABASE CONFIGURATION (MySQL)
# ========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=salarykart_lms
DB_CONNECTION_LIMIT=10

# MySQL Connection URL (for Prisma/ORM if needed)
DATABASE_URL=mysql://root:@localhost:3306/salarykart_lms

# ========================================
# 🔑 JWT AUTHENTICATION
# ========================================
# Token expires in 1 HOUR (3600 seconds)
JWT_SECRET=2b463dd6d9e7c66f28e7807415b01d9bd93e0462fcaca40b97c4c8a2d50a97b5

# ========================================
# 📧 EMAIL CONFIGURATION (Gmail)
# ========================================
# Replace with your actual Gmail credentials
# Get App Password from: https://myaccount.google.com/apppasswords

EMAIL_USER=it@rupeelending.com
EMAIL_APP_PASSWORD=zgwy yptg isge ugvd

# Email sender name (appears in "From" field)
EMAIL_FROM_NAME=RupeeLending

# ========================================
# 🌐 APPLICATION URLs
# ========================================
# Development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Production (uncomment when deploying)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ========================================
# 🔧 NODE ENVIRONMENT
# ========================================
NODE_ENV=development

# ========================================
# ⏰ SESSION & TOKEN SETTINGS
# ========================================
# JWT token expires after 1 hour (in seconds)
TOKEN_EXPIRY=3600

# OTP expires after 10 minutes (in milliseconds)
OTP_EXPIRY=600000

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# ========================================
# 🛡️ SECURITY SETTINGS
# ========================================
# Rate limiting: Max requests per 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Bcrypt salt rounds (10-12 recommended)
BCRYPT_SALT_ROUNDS=12

# ========================================
# 📱 CORS SETTINGS (if needed)
# ========================================
# Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ========================================
# 📝 LOGGING & DEBUGGING
# ========================================
# Set to 'true' to enable debug logs
DEBUG=false
LOG_LEVEL=info

# ========================================
# 📊 OPTIONAL: Third-party Services
# ========================================
# Uncomment if you use these services

# SMS Provider (Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# File Upload (AWS S3)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_S3_BUCKET=your_bucket_name
# AWS_REGION=ap-south-1

# Payment Gateway (Razorpay)
# RAZORPAY_KEY_ID=your_razorpay_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret

# Analytics (Google Analytics)
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# ========================================
# ✅ SETUP COMPLETED!
# ========================================
# 
# 🎯 NEXT STEPS:
# 
# 1. Replace EMAIL_USER with your Gmail address
# 2. Generate Gmail App Password:
#    - Go to: https://myaccount.google.com/security
#    - Enable 2-Step Verification
#    - Go to App Passwords
#    - Create new password for "Mail"
#    - Copy the 16-character password
#    - Paste as EMAIL_APP_PASSWORD
# 
# 3. Run the application:
#    npm install
#    npm run dev
# 
# 4. Test authentication:
#    - Open http://localhost:3000
#    - Should redirect to /login
#    - Enter email → Receive OTP
#    - Verify OTP → Login successful!
# 
# ========================================
