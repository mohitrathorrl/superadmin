# ========================================
# 🔐 Environment Configuration - RupeeLending
# ========================================

# ========================================
# 📊 DATABASE CONFIGURATION (MySQL)
# ========================================
# PRODUCTION VALUES - Update these for your server
DB_HOST=localhost
DB_USER=salarykart_admin
DB_PASSWORD=sal@ryk@rt*&#2024
DB_NAME=lms_v2
DB_CONNECTION_LIMIT=20

# MySQL Connection URL (for Prisma/ORM if needed)
DATABASE_URL=mysql://salarykart_admin:sal@ryk@rt*&#2024@localhost:3306/lms_v2

# ========================================
# 🔑 JWT AUTHENTICATION
# ========================================
# Token expires in 1 HOUR (3600 seconds)
# IMPORTANT: Generate a new secret for production!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=2b463dd6d9e7c66f28e7807415b01d9bd93e0462fcaca40b97c4c8a2d50a97b5

# ========================================
# 📧 EMAIL CONFIGURATION (Gmail)
# ========================================
# Replace with your actual Gmail credentials
# Get App Password from: https://myaccount.google.com/apppasswords

EMAIL_USER=it@rupeelending.com
EMAIL_APP_PASSWORD=zgwy yptg isge ugvd

# Email sender name (appears in "From" field)
EMAIL_FROM_NAME=RupeeLending

# ========================================
# 🌐 APPLICATION URLs
# ========================================
# Development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Production (uncomment and update when deploying)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ========================================
# 🔧 NODE ENVIRONMENT
# ========================================
NODE_ENV=production

# ========================================
# ⏰ SESSION & TOKEN SETTINGS
# ========================================
# JWT token expires after 1 hour (in seconds)
TOKEN_EXPIRY=3600

# OTP expires after 10 minutes (in milliseconds)
OTP_EXPIRY=600000

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# ========================================
# 🛡️ SECURITY SETTINGS
# ========================================
# Rate limiting: Max requests per 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Bcrypt salt rounds (10-12 recommended)
BCRYPT_SALT_ROUNDS=12

# ========================================
# 📱 CORS SETTINGS (if needed)
# ========================================
# Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ========================================
# 📝 LOGGING & DEBUGGING
# ========================================
# Set to 'true' to enable debug logs
DEBUG=false
LOG_LEVEL=info

# ========================================
# ✅ DEPLOYMENT CHECKLIST
# ========================================
# 
# Before deploying to production:
# 
# 1. ✅ Update DB credentials above
# 2. ✅ Generate new JWT_SECRET
# 3. ✅ Set NODE_ENV=production
# 4. ✅ Update NEXT_PUBLIC_APP_URL
# 5. ✅ Update NEXT_PUBLIC_API_URL
# 6. ✅ Test database connection: npm run db:test
# 7. ✅ Run build: npm run build
# 8. ✅ Start production: npm start
# 
# ========================================
